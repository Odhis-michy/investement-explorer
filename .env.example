GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: email price alerts (for Gmail use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=

# Optional: SMS price alerts via Africa's Talking (use AT_USERNAME=sandbox to test)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ...or via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Background price alerts (runs inside the app server; set to 0 if you run alert_worker.py instead)
BACKGROUND_ALERTS=1
ALERT_CHECK_MINUTES=2
PRICE_REFRESH_MINUTES=15

# Database for user accounts. Leave empty to use a local SQLite file (data/app.db).
# On Streamlit Community Cloud use a free Postgres (Supabase / Neon) — its disk is wiped on restart.
DATABASE_URL=
